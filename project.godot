; Siam Life — Godot 4 project configuration
; Engine configuration file.
; Generated by hand for the initial scaffold; the editor will rewrite/expand it
; the first time the project is opened and saved.

config_version=5

[application]

config/name="Siam Life"
config/version="0.1.0"
config/description="A 2D top-down life simulation set in Thailand."
run/main_scene="res://src/ui/menus/main_menu.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/show_image=false

[autoload]

EventBus="*res://src/autoload/event_bus.gd"
SettingsManager="*res://src/autoload/settings_manager.gd"
Database="*res://src/autoload/database.gd"
AudioManager="*res://src/autoload/audio_manager.gd"
SaveManager="*res://src/autoload/save_manager.gd"
GameClock="*res://src/autoload/game_clock.gd"
GameState="*res://src/autoload/game_state.gd"
Inventory="*res://src/autoload/inventory.gd"
DialogueSystem="*res://src/autoload/dialogue_system.gd"
SceneLoader="*res://src/autoload/scene_loader.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

2d/default_gravity=0.0

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="npc"
2d_physics/layer_4="interactable"
2d_physics/layer_5="trigger"
2d_render/layer_1="default"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_2d=0

[audio]

buses/default_bus_layout="res://resources/themes/default_bus_layout.tres"

