[gd_scene format=3]

[ext_resource type="Script" path="res://src/systems/economy/shipping_bin.gd" id="1_bin"]
[ext_resource type="Script" path="res://src/components/world_body.gd" id="2_body"]
[ext_resource type="Script" path="res://src/components/placeholder_visual.gd" id="3_vis"]
[ext_resource type="Resource" path="res://resources/world_objects/wo_shipping_bin.tres" id="4_data"]

[node name="ShippingBin" type="Area2D"]
script = ExtResource("1_bin")
prompt = "ฝากของ"
prompt_en = "Ship"
focus_priority = 5

[node name="Visual" type="ColorRect" parent="."]
color = Color(0.45, 0.32, 0.18, 1)
mouse_filter = 2

[node name="Body" type="StaticBody2D" parent="."]
collision_layer = 1
collision_mask = 0

[node name="WorldBody" type="Node" parent="." node_paths=PackedStringArray("collision_body", "interaction_area")]
